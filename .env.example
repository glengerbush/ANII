# After a release is published, replace this with its versioned image or digest.
LIFE_IMAGE=ghcr.io/OWNER/REPO:0.1.0

# Exact browser origin, without a trailing slash.
ORIGIN=http://localhost:3000

# Bind locally by default. Set a trusted LAN address for direct LAN access.
BIND_ADDRESS=127.0.0.1
APP_PORT=3000
