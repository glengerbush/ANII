# Dependencies and generated builds
node_modules/
.svelte-kit/
/build/
/dist/

# Local app data and database sidecars
/data/*
!/data/.gitkeep
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Credentials and machine-specific environment; retain shareable templates
.env
.env.*
!.env.example
!.env.sample

# Generated bundles, screenshots, test reports, and logs
/artifacts/
/coverage/
/playwright-report/
/test-results/
*.log

# Python tooling used by deployment scripts
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Local agent preferences and OS metadata
/.codex/
/.impeccable/
.DS_Store
Thumbs.db

# Private research, experiments, server notes, and archived local history
/scratch/
