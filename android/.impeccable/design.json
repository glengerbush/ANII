  "narrative": {
    "northStar": "ANII, native Android",
    "overview": "ANII\u2019s established warm cream and teal identity, adapted to native Android planning. Compose Material 3 supplies typography, touch controls, sheets, and navigation. Content remains compact and practical, with flat task lists and restrained tonal selection.\n\nThis document applies only to the Android app. MainActivity.kt owns its light/dark color mapping; the web design system remains separate. Native defaults are inherited from the installed Compose Material 3 version, not independently redefined here.",
    "keyCharacteristics": [
      "Warm neutral grounds; teal actions and selection.",
      "Native Material typography and controls.",
      "Flat task rows; tonal containers for selection and overlays.",
      "System light/dark appearance."
    ],
    "rules": [
      {
        "name": "The Shared Accent Rule",
        "body": "Primary, secondary, and tertiary roles share teal and the same selected-container pair.",
        "section": "colors"
      },
      {
        "name": "The Native Roles Rule",
        "body": "Use Material typography roles; the app defines no custom font family or type scale.",
        "section": "typography"
      },
      {
        "name": "The Flat List Rule",
        "body": "Task rows sit directly on the background, separated by subdued dividers.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the full-window themed Surface, including before a server is connected.",
      "Do use paired foreground/background roles in both system themes.",
      "Do preserve native labels, icon descriptions, focus behavior, and touch controls.",
      "Do use native sheets and dialogs for task actions and editing."
    ],
    "donts": [
      "Don't introduce a separate secondary or tertiary accent; all three roles currently share teal.",
      "Don't replace task rows with decorative elevated cards.",
      "Don't treat preview CSS, synthesized tonal ramps, or inherited Material defaults as new application tokens."
    ]
  }
